---
import Layout from "$/layouts/Layout.astro"
import logo from "$/../public/blue.svg"
import { Bootstrap, Braces, Code, WindowSidebar, BoxSeam } from "react-bootstrap-icons"

import ReadMe from "blue-web/README.md"
---

<Layout>
    <div class="welcome-jumbotron text-center p-12 bg-subtle-primary border-bottom">
        <h1 class="fs-4xl d-inline-flex align-items-center" style={{ fontWeight: "600" }}>
            <img src={logo.src} alt="Blue logo" style={{ height: "1em" }} class="me-5" /> Blue Web
        </h1>

        <p class="h2">UI library based on Bootstrap 6 Alpha 1</p>
        <div class="h2 fg-emphasis-primary">
            <Bootstrap />
            <Braces />
            <Code />
            <WindowSidebar />
            <BoxSeam />
        </div>
    </div>

    <div class="bg-body fg-body">
        <div class="welcome-container container markdown-rendered py-1">
            <ReadMe />
        </div>
    </div>
</Layout>
