---
import Layout from "./Layout.astro"

export type Heading = { depth: number; slug: string; text: string }

let currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, "")

if (currentPath.endsWith("/")) {
    currentPath = currentPath.slice(0, -1)
}

const pathTitle = decodeURIComponent(currentPath.split("/")[1])

// Extract title from frontmatter props or use path-based title as fallback
const title = Astro.props.frontmatter?.title || pathTitle
type Props = {
    url?: string
    frontmatter?: any
    headings?: Array<Heading>
}
const { headings } = Astro.props

const url = Astro.props.url || Astro.url
---

<Layout title={`${title} • Blue`}>
    <div class="container-fluid">
        <div class="row">
            <div class="md:col-9 markdown-rendered position-relative">
                <button
                    type="button"
                    class="btn btn-outline theme-secondary md:d-none mt-5"
                    command="show-modal"
                    commandfor="toc">On this page</button
                >

                <slot />

                <div class="mb-5">
                    <a
                        href={`https://github.com/bruegmann/blue-web/edit/main/site/src/pages/${currentPath}.mdx`}
                        class="link-secondary">Edit post on GitHub</a
                    >
                </div>
            </div>

            <div class="md:col-3">
                <div class="sticky-top pt-7">
                    <dialog class="blue-md-modal blue-modal drawer drawer-end" id="toc" aria-describedby="tocLabel" closedby="any">

                            <div class="drawer-header">
                                <h2 class="h5 drawer-title" id="tocLabel">On this page</h2>
                                <form method="dialog" style="display: contents;">
                                    <button type="submit" class="btn-close" aria-label="Close"></button>
                                </form>
                            </div>
                            <div class="drawer-body">
                                <h2 class="page-header h5 d-none md:d-block">On this page</h2>

                                <nav class="docs-toc">
                                    <ul>
                                        {
                                            headings &&
                                                headings.map((heading: Heading) => (
                                                    <li style={`padding-left: ${heading.depth - 1}rem`}>
                                                        <a href={`${url}#${heading.slug}`}>{heading.text}</a>
                                                    </li>
                                                ))
                                        }
                                    </ul>
                                </nav>
                            </div>

</dialog>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { init } from "blue-web/dist/js/modal-responsive"

    document.addEventListener("DOMContentLoaded", () => {
        const tocEl = document.getElementById("toc")
        if (tocEl) {
            init(tocEl as HTMLDialogElement)
        }
    })
</script>
