{
    "name": "docs",
    "version": "1.30.2",
    "private": true,
    "description": "UI components built on top of Bootstrap 5",
    "license": "LGPL-3.0-or-later",
    "type": "module",
    "homepage": "https://bruegmann.github.io/blue-web/v1",
    "repository": {
        "url": "https://github.com/bruegmann/blue-web"
    },
    "bugs": {
        "url": "https://github.com/bruegmann/blue-react/issues"
    },
    "scripts": {
        "build": "npm run license-report && astro build",
        "predeploy": "npm run build",
        "deploy": "gh-pages --dist dist --dest v1",
        "prettier": "npx prettier --write .",
        "license-report": "npx license-report --prod --output=json > src/assets/license-report.json",
        "dev": "astro dev",
        "preview": "astro preview",
        "version": "npm run build && git add -A",
        "postversion": "npm run deploy && git push --follow-tags"
    },
    "devDependencies": {
        "@astrojs/mdx": "^4.3.13",
        "@astrojs/react": "^4.4.2",
        "@types/bootstrap": "^5.0.17",
        "@types/node": "^26.1.1",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@types/react-syntax-highlighter": "^13.5.0",
        "astro": "^5.16.5",
        "blue-react": "workspace:",
        "blue-themify": "^1.0.0",
        "blue-web": "workspace:",
        "bootstrap": "^5.3.8",
        "clsx": "^2.1.1",
        "colorjs.io": "^0.5.2",
        "gh-pages": "^3.1.0",
        "license-report": "^6.2.0",
        "lint-staged": "^11.1.2",
        "postcss-cli": "^9.0.1",
        "postcss-minify": "^1.1.0",
        "postcss-only-vars": "^1.0.0",
        "prettier": "^3.5.3",
        "react": "^19.0.0",
        "react-bootstrap-icons": "^1.11.5",
        "react-docgen": "^8.0.3",
        "react-docgen-typescript": "^2.4.0",
        "react-dom": "^19.0.0",
        "react-markdown": "^8.0.3",
        "react-syntax-highlighter": "^15.4.3",
        "sass": "^1.93.2",
        "typescript": "^4.3.5",
        "unist-util-visit": "^5.0.0"
    },
    "eslintConfig": {
        "extends": "react-app"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
