{
    "name": "blue-react",
    "version": "11.3.2",
    "description": "Blue React Components",
    "license": "LGPL-3.0-or-later",
    "type": "module",
    "main": "index.js",
    "types": "index.d.ts",
    "homepage": "https://bruegmann.github.io/blue/react",
    "repository": {
        "type": "git",
        "url": "https://github.com/bruegmann/blue"
    },
    "bugs": {
        "url": "https://github.com/bruegmann/blue/issues"
    },
    "scripts": {
        "dev": "babel ./src/components --out-dir ./dist/components --extensions \".tsx,.js,.ts\" --watch",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "build-types": "tsc -p tsconfig.app.json --declaration --emitDeclarationOnly --declarationDir ./dist --noEmit false --composite false",
        "build": "babel ./src/components --out-dir ./dist/components --extensions \".tsx,.js,.ts\"",
        "build-release": "npm run build-types && npm run build",
        "prepublishOnly": "npm i && npm run build-release",
        "release": "npm publish && npm run deploy"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.5",
        "blue-web": "workspace:*",
        "bootstrap": "~5.3.3",
        "clsx": "^1.1.1"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.10.4",
        "@babel/preset-env": "^7.10.4",
        "@babel/preset-react": "^7.10.4",
        "@babel/preset-typescript": "^7.9.0",
        "@types/bootstrap": "^5.2.11",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.46.4",
        "@typescript-eslint/parser": "^8.46.4",
        "babel-plugin-add-import-extension": "^1.6.0",
        "babel-plugin-react-compiler": "^19.1.0-rc.3",
        "eslint": "^9.37.0",
        "eslint-plugin-react-hooks": "^6.1.1",
        "eslint-plugin-react-refresh": "^0.4.7",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "typescript": "^5.9.3"
    }
}
