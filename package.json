{
    "name": "blue",
    "private": true,
    "packageManager": "pnpm@11.25.0",
    "scripts": {
        "build": "pnpm -r build",
        "build-release": "pnpm -r build-release",
        "dev": "concurrently \"pnpm --filter blue-web dev\" \"pnpm --filter blue-react dev\" \"pnpm --filter docs dev\"",
        "lint": "pnpm -r lint",
        "deploy": "pnpm --filter docs deploy"
    },
    "dependencies": {
        "concurrently": "^10.0.3"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "prettier": "^3.9.6"
    }
}
